{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-gap-index",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-gap-index",
      "database_id": "ab1be485-a876-428f-be73-46eb8060fdad"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ai-gap-index-preview",
        "database_id": "72ac0e37-54c5-4948-b6cb-fe4bed3581a4"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
