# Set this to the canonical production origin before deploying.
SITE_URL=https://your-domain.com
PORT=3000

# SQLite file path. In production, mount a persistent volume for ./data.
DB_PATH=./data/gap-index.sqlite

# Optional Resend contacts integration. Without both values, signups are stored locally only.
# RESEND_API_KEY=re_...
# RESEND_AUDIENCE_ID=...

# Cloudflare Workers (wrangler.jsonc): INGEST_TOKEN is a Worker secret, not a committed var.
# For local `wrangler dev`, put INGEST_TOKEN in .dev.vars (gitignored).
# SITE_URL=https://your-worker.workers.dev
